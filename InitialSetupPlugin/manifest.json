{
  "manifest_version": "2.0.0",
  "plugin_id": "initial-setup-plugin",
  "name": "MetricsApp.Setup.InitialSetup",
  "version": "1.0.0",
  "title": "Initial Setup",
  "description": "Provides the initial setup wizard for MetricsApp, including database initialization, primary data source configuration, and initial user/organization setup.",
  
  "capabilities": ["setup", "routes"],
  
  "tags": [
    "Setup",
    "Configuration",
    "Initialization",
    "Wizard"
  ],
  
  "author": {
    "name": "Colton Spears",
    "email": "coltonspears09@gmail.com",
    "homepage": "https://github.com/coltonspears09"
  },
  
  "license": "MIT",
  
  "entry": {
    "assembly": "InitialSetupPlugin.dll",
    "frontend_bundle": "/plugins/initial-setup-plugin/bundle.js"
  },
  
  "dependencies": {
    "plugins": {},
    "platform": {
      "metricsapp": ">=1.0.0"
    }
  },
  
  "exports": {
    "routes": [
      {
        "path": "/setup",
        "component": "InitialSetupWizard",
        "title": "Initial Setup",
        "requiresAuth": false
      },
      {
        "path": "/setup/database",
        "component": "DatabaseSetup",
        "title": "Database Configuration",
        "requiresAuth": false
      },
      {
        "path": "/setup/datasource",
        "component": "DataSourceSetup",
        "title": "Primary Data Source",
        "requiresAuth": false
      }
    ]
  },
  
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "primaryDataSourceId": {
          "type": "string",
          "title": "Primary Data Source",
          "description": "The ID of the primary data source for the application"
        },
        "setupCompleted": {
          "type": "boolean",
          "title": "Setup Completed",
          "default": false
        },
        "setupCompletedAt": {
          "type": "string",
          "title": "Setup Completed At",
          "description": "Timestamp when setup was completed"
        }
      }
    }
  },
  
  "permissions": [
    "setup:read",
    "setup:write",
    "datasources:write"
  ],
  
  "assets": {
    "dashboards": [
      "assets/dashboards/initial-setup-overview.json"
    ]
  }
}
