{
  "MetricsAgent": {
    "Collectors": {
      "WindowsPerfCounters": {
        "DefaultFrequencySeconds": 30,
        "EnableSystemCounters": true,
        "EnableProcessCounters": false,
        "MaxInstances": 100,
        "GlobalTags": {
          "environment": "production",
          "datacenter": "us-east-1"
        },
        "CounterSets": [
          "system-basic",
          "network"
        ],
        "Counters": [
          {
            "CounterSet": "Processor",
            "CounterName": "% Processor Time",
            "InstanceName": "*",
            "DisplayName": "CPU Usage Per Core",
            "Unit": "percent",
            "Enabled": true,
            "FrequencySeconds": 15,
            "Tags": {
              "metric_type": "performance",
              "category": "cpu"
            }
          },
          {
            "CounterSet": "Memory", 
            "CounterName": "Available MBytes",
            "DisplayName": "Available Memory",
            "Unit": "MB",
            "Enabled": true,
            "Tags": {
              "metric_type": "performance",
              "category": "memory"
            }
          },
          {
            "CounterSet": "PhysicalDisk",
            "CounterName": "% Disk Time", 
            "InstanceName": "C:",
            "DisplayName": "Disk C: Usage",
            "Unit": "percent",
            "Enabled": true,
            "Tags": {
              "metric_type": "performance",
              "category": "disk",
              "drive": "C"
            }
          },
          {
            "CounterSet": "Process",
            "CounterName": "% Processor Time",
            "InstanceName": "w3wp",
            "DisplayName": "IIS Worker Process CPU",
            "Unit": "percent",
            "Enabled": false,
            "Tags": {
              "metric_type": "process",
              "application": "iis"
            }
          }
        ]
      }
    }
  }
} 