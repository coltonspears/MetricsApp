{
  "manifest_version": "2.0.0",
  "plugin_id": "sqlserver-datasource-plugin",
  "name": "SQL Server DataSource",
  "version": "0.0.1",
  "title": "SQL Server Data Source",
  "description": "Provides SQL Server as a data repository for MetricsApp, collecting important SQL Server performance and health metrics.",
  
  "capabilities": ["datasource", "persistence"],
  
  "tags": [
    "Data Stores",
    "Integration",
    "Windows",
    "Linux",
    "macOS",
    "Database"
  ],
  
  "author": {
    "name": "Colton Spears",
    "email": "coltonspears09@gmail.com",
    "homepage": "https://github.com/coltonspears09"
  },
  
  "license": "MIT",
  
  "entry": {
    "assembly": "SqlServerPlugin.dll",
    "frontend_bundle": "/plugins/sqlserver-plugin/bundle.js"
  },
  
  "dependencies": {
    "plugins": {},
    "platform": {
      "metricsapp": ">=1.0.0"
    }
  },
  
  "exports": {
    "datasources": [
      {
        "type": "sqlserver",
        "displayName": "SQL Server",
        "description": "Microsoft SQL Server database",
        "icon": "database",
        "categories": ["Database", "Microsoft"]
      }
    ]
  },
  
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "connectionString": {
          "type": "string",
          "title": "Connection String",
          "description": "SQL Server connection string"
        },
        "timeout": {
          "type": "integer",
          "title": "Query Timeout",
          "description": "Query timeout in seconds",
          "default": 30
        }
      },
      "required": ["connectionString"]
    }
  },
  
  "permissions": [
    "datasources:read",
    "datasources:write"
  ],
  
  "assets": {
    "dashboards": [
      "assets/dashboards/SQLServer-Overview_dashboard.json",
      "assets/dashboards/sqlserver_dashboard.json"
    ],
    "alerts": [
      "assets/alerts/sqlserver_high_processes_blocked.json"
    ]
  }
}
